# Replace with an owned hostname. Keep the admin port bound to loopback.
# CI exercises this recipe's routing over isolated HTTP, not external TLS.
{
    servers {
        timeouts {
            read_header 5s
            read_body 5s
            write 10s
            idle 30s
        }
    }
}
webhooks.example.com {
    @ingress {
        path /ingress /ingress/stripe
        method POST
        # Reject encoded, normalized, trailing and query variants of the URI.
        expression `{http.request.orig_uri} == "/ingress" || {http.request.orig_uri} == "/ingress/stripe"`
    }
    handle @ingress {
        request_body {
            max_size 65536
        }
        reverse_proxy 127.0.0.1:4319 {
            header_up Host localhost
            header_up -Authorization
            transport http {
                max_conns_per_host 8
                dial_timeout 2s
                read_timeout 8s
                write_timeout 8s
                response_header_timeout 8s
            }
        }
    }
    handle {
        respond "Not found" 404
    }
}
